# Copy to backend/.env and fill in. Never commit backend/.env.
# Everything is optional except what you need for the mailbox you connect.

# --- Storage ------------------------------------------------------------------
# Unset = ~/Library/Application Support/AppTracker on macOS.
# DATA_DIR=./data
# Keep the encryption key in the macOS Keychain instead of DATA_DIR/secret.key
# (needs `pip install keyring`; note that backups then do not include the key).
# USE_KEYCHAIN=false

# --- Local model (Ollama only; there is no cloud fallback) ---------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Verify the exact tag with `ollama list`; must match an installed model.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=180

# --- Gmail (read-only) ----------------------------------------------------------
# Google Cloud Console -> OAuth client ID -> "Desktop app". Scope used: gmail.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Outlook / Microsoft 365 (read-only) ---------------------------
# Entra ID app registration, public client, "Mobile and desktop applications" platform,
# redirect http://localhost:8000/api/oauth/microsoft/callback. Delegated permission: Mail.Read.
MICROSOFT_CLIENT_ID=
# common = work/school + personal; consumers = outlook.com/hotmail only; or your tenant id.
MICROSOFT_TENANT=common

# Must match the port the backend runs on (the launcher may move off 8000 if busy).
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# --- Local security -------------------------------------------------------------
# Loopback only. Do NOT change unless you have added authentication + TLS.
BIND_HOST=127.0.0.1
ALLOW_NON_LOOPBACK=false
# Bearer token for POST /api/integrations/*. Generated and stored encrypted if unset.
# INTEGRATION_TOKEN=

# --- Misc -------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
EMAIL_POLL_INTERVAL_SECONDS=900
DISPLAY_TIMEZONE=America/New_York
